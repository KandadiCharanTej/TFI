# Canonical public URL of the deployed site (used for sitemap, robots.txt, and OG tags)
NEXT_PUBLIC_SITE_URL=https://tfi-and-pitch.example

# Set to "true" only in development to preview post-beta MVP games (cricket etc.)
SHOW_MVP_GAMES=false

# Optional URL (e.g. Google Form or Tally) for the "Send feedback" sticker. Leave blank to hide.
FEEDBACK_URL=

# Optional PostHog project API key (only sends anonymous counts when user taps Yes on consent)
POSTHOG_KEY=

# Optional Sentry DSN for client-side unhandled error reporting
SENTRY_DSN=
